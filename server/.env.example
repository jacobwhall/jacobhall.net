# Copy to .env (gitignored) and fill in.

# PostgreSQL connection string, e.g. postgres://user:pass@localhost/jacobhall
DATABASE_URL=

# Address to bind (Racket parity default)
BIND_ADDR=127.0.0.1:8000

# Path to the content tree (the repo root). The server must be able to read it.
DOCROOT=.

# Public origin used to build permalinks and feed URLs
BASE_URL=https://jacobhall.net

# Where the minijinja templates live
TEMPLATES_DIR=server/templates

# Owner password for the /admin moderation area (unset = admin disabled)
ADMIN_PASSWORD=

# Secret for signing admin session cookies (>= 32 random characters;
# unset = random per boot, sessions won't survive restarts)
COOKIE_KEY=
